# Porta da API Express (o Vite usa 5173 em desenvolvimento e faz proxy de /api para cá)
PORT=3001

# Credenciais da uazapi — também podem ser definidas pela tela de configurações do painel
# (o que for salvo pela tela tem prioridade sobre estes valores)
UAZAPI_URL=https://seusubdominio.uazapi.com
UAZAPI_TOKEN=

# Login do painel (tela de login). Sem ADMIN_PASSWORD o painel fica SEM login.
# Trocar a senha encerra todas as sessões abertas. (APP_PASSWORD ainda é aceito.)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Opcional: segredo das sessões. Se vazio, é gerado e salvo em DATA_DIR/session.key
# SESSION_SECRET=

# Endereço público do painel. A uazapi baixa as mídias por ele, o que é obrigatório para
# arquivos acima de 45 MB (vídeos até 512 MB). No Railway é detectado sozinho pelo domínio gerado.
# PUBLIC_URL=https://disparos.suaempresa.com.br

# Instância uazapi própria do financeiro (régua de cobrança), separada da das campanhas.
# Opcional: também pode ser configurada em Cobrança → Configurações (que tem prioridade).
# UAZAPI_FIN_URL=https://seusubdominio.uazapi.com
# UAZAPI_FIN_TOKEN=

# SMTP dos e-mails da régua de cobrança (opcional: também pode ser configurado na tela
# Cobrança → Configurações, que tem prioridade)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=financeiro@suaempresa.com.br
# SMTP_PASS=senha-de-app
# SMTP_FROM=financeiro@suaempresa.com.br
# SMTP_FROM_NAME=Financeiro

# Pasta onde ficam campanhas, mídias enviadas e config.json (padrão: ./data)
# DATA_DIR=data
